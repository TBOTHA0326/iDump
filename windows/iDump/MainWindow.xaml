<ui:FluentWindow
    x:Class="IDump.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:IDump.ViewModels"
    Title="iDump"
    Width="1300"
    Height="820"
    MinWidth="980"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <!-- Sidebar rows -->
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="12,8">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grid tiles -->
        <Style x:Key="Tile" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="6" Background="Transparent">
                            <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="{Binding KindSymbol}" FontSize="28"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="8" Background="#18FFFFFF" Opacity="0" />

                            <!-- Live Photo badge -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="5,1"
                                    CornerRadius="4" Background="#8C000000"
                                    Visibility="{Binding IsLivePhoto, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="LIVE" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                            </Border>

                            <!-- Size / video badges -->
                            <DockPanel VerticalAlignment="Bottom" Margin="6" LastChildFill="False">
                                <Border x:Name="SizeBadge" DockPanel.Dock="Left" CornerRadius="9" Padding="7,2" Background="#8C000000">
                                    <TextBlock Text="{Binding SizeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                                <Border DockPanel.Dock="Right" CornerRadius="9" Padding="6,3" Background="#8C000000"
                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                    <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="11" Foreground="White" />
                                </Border>
                            </DockPanel>

                            <Border x:Name="Ring" CornerRadius="8" BorderThickness="3" BorderBrush="Transparent" />
                            <Grid x:Name="Check" Width="22" Height="22" Margin="6" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" Visibility="Collapsed">
                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" Stroke="White" StrokeThickness="1.5" />
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Foreground="White" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLarge}" Value="True">
                                <Setter TargetName="SizeBadge" Property="Background" Value="#E6FF9500" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="iDump" Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ===================== Sidebar ===================== -->
            <Grid Grid.Column="0" Margin="12,0,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="LIBRARY" Margin="12,6,0,6" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                         ItemContainerStyle="{StaticResource SidebarItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{Binding Brush}" FontSize="18"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"
                                               Visibility="{Binding CountText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Device card -->
                <Border Grid.Row="2" Padding="14" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Phone24" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DeviceTitle}" FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{Binding DeviceStatusBrush}" Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DeviceStatusText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasTotals, Converter={StaticResource BoolToVisibility}}">
                            <Grid Height="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding PhotoShare}" />
                                    <ColumnDefinition Width="{Binding ScreenshotShare}" />
                                    <ColumnDefinition Width="{Binding VideoShare}" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="#0A84FF" RadiusX="3" RadiusY="3" Margin="0,0,1,0" />
                                <Rectangle Grid.Column="1" Fill="#BF5AF2" RadiusX="3" RadiusY="3" Margin="1,0" />
                                <Rectangle Grid.Column="2" Fill="#FF9F0A" RadiusX="3" RadiusY="3" Margin="1,0,0,0" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Ellipse Grid.Row="0" Width="7" Height="7" Fill="#0A84FF" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Photos" FontSize="12" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PhotoBytesText}" Style="{StaticResource Caption}" />
                                <Ellipse Grid.Row="1" Width="7" Height="7" Fill="#BF5AF2" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Screenshots" FontSize="12" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ScreenshotBytesText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                <Ellipse Grid.Row="2" Width="7" Height="7" Fill="#FF9F0A" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Videos" FontSize="12" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding VideoBytesText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                <Separator Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="Total" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding TotalBytesText}" FontSize="12" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Content ===================== -->
            <Grid Grid.Column="1" Margin="6,0,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header + toolbar -->
                <Grid Margin="4,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Width="190" PlaceholderText="Search file names" Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
                        <ComboBox Width="170" Margin="8,0,0,0" ItemsSource="{Binding SizeFilters}"
                                  SelectedItem="{Binding SizeFilter}" ToolTip="Filter by file size" />
                        <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding Sort}" ToolTip="Sort order" />
                        <ui:SymbolIcon Symbol="Grid24" Margin="12,0,4,0" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Slider Width="100" Minimum="90" Maximum="280" Value="{Binding TileSize}"
                                VerticalAlignment="Center" ToolTip="Thumbnail size" />
                        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon SelectAllOn24}" ToolTip="Select all (Ctrl+A)"
                                   Click="SelectAll_Click" IsEnabled="{Binding IsReady}" />
                        <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon PanelRight24}" ToolTip="Show or hide details"
                                   Click="ToggleInspector_Click" />
                    </StackPanel>
                </Grid>

                <ui:InfoBar Grid.Row="1" Margin="0,0,0,8" IsOpen="{Binding IsReady}" IsClosable="True"
                            Severity="Informational" Title="Before you move anything"
                            Message="iCloud Photos must be off on the iPhone, and set Settings › Photos › Transfer to Mac or PC to 'Keep Originals' so copies can be verified." />

                <!-- The grid -->
                <ListBox x:Name="MediaGrid" Grid.Row="2" ItemsSource="{Binding VisibleItems}" SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource Tile}" Background="Transparent" BorderThickness="0"
                         SelectionChanged="MediaGrid_SelectionChanged" MouseDoubleClick="MediaGrid_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ui:VirtualizingWrapPanel ItemSize="{Binding DataContext.ItemSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SpacingMode="StartAndEndOnly" StretchItems="False" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- Empty / status states -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="{Binding PlaceholderSymbol}" FontSize="52" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding ShowSpinner, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" HorizontalAlignment="Center"
                                     Visibility="{Binding ShowSpinner, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding PlaceholderTitle}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Text="{Binding PlaceholderMessage}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Action bar -->
                <Border Grid.Row="3" Margin="0,8,0,0" Padding="16,10" CornerRadius="8" MinHeight="54"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <DockPanel VerticalAlignment="Center"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"
                                       Text="Ctrl+click to pick several · Shift+click for a range · Ctrl+A for all" />
                            <TextBlock Text="Select items to copy or move them off your iPhone."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                        <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="Copy to drive…" Icon="{ui:SymbolIcon Copy24}" Click="Copy_Click" Padding="14,7" />
                                <ui:Button Content="Move to drive…" Icon="{ui:SymbolIcon ArrowExportUp24}" Click="Move_Click"
                                           Appearance="Primary" Margin="8,0,0,0" Padding="14,7" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectionBytesText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Content="Deselect" Appearance="Transparent" Margin="6,0,0,0" Click="Deselect_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== Inspector ===================== -->
            <Border x:Name="Inspector" Grid.Column="2" Width="310" Margin="6,0,12,12" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <!-- Nothing selected -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding IsNone, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="CursorClick24" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No selection" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Select a photo or video to preview it. Tip: sort by 'Largest first' to find what's eating your storage." />
                    </StackPanel>

                    <!-- One item -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid MinHeight="200" MaxHeight="340">
                                <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="10"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Visibility="{Binding PreviewLoading, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button HorizontalAlignment="Center" VerticalAlignment="Center" Width="56" Height="56"
                                           CornerRadius="28" Icon="{ui:SymbolIcon Play24}" FontSize="22"
                                           ToolTip="Play video (copies it to a temporary folder first)"
                                           Command="{Binding OpenOriginalCommand}"
                                           Visibility="{Binding SingleItem.IsVideo, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            </Grid>

                            <TextBlock Text="{Binding SingleItem.Name}" FontSize="17" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,14,0,2" />
                            <TextBlock Text="{Binding SingleItem.KindText}" Foreground="{Binding SingleItem.KindBrush}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Size" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,14,6" />
                                <TextBlock Grid.Column="1" Text="{Binding SingleItem.SizeText}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Includes the Live Photo video" Style="{StaticResource Caption}"
                                           Margin="0,0,0,6"
                                           Visibility="{Binding SingleItem.IsLivePhoto, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                <TextBlock Grid.Row="2" Text="Taken" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,14,6" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SingleItem.DateText}" />
                                <TextBlock Grid.Row="3" Text="Folder" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,14,6" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SingleItem.Folder}" />
                            </Grid>

                            <ui:Button Content="Open original" Icon="{ui:SymbolIcon Open24}" HorizontalAlignment="Stretch"
                                       Margin="0,14,0,0" Padding="12,8" Command="{Binding OpenOriginalCommand}" />
                            <TextBlock Text="{Binding PreviewNote}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding PreviewNote, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Several items -->
                    <StackPanel Visibility="{Binding IsMulti, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="44" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,4,0,12" />
                        <TextBlock Text="{Binding SelectionText}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectionBytesText}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="will be freed if you move these off your iPhone" Style="{StaticResource Caption}" />
                        <Border Margin="0,16,0,0" Padding="12" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ItemsControl ItemsSource="{Binding MultiBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" />
                                            <TextBlock Text="{Binding Title}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
