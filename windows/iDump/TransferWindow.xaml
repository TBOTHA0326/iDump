<ui:FluentWindow
    x:Class="IDump.TransferWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="iDump"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <StackPanel>
        <ui:TitleBar Title="{Binding Heading}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <!-- ============ Setup ============ -->
        <StackPanel Margin="24,4,24,24" Visibility="{Binding IsSetup, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <ui:SymbolIcon Symbol="ArrowExportUp24" FontSize="26" Foreground="White" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Destination" FontWeight="SemiBold" Margin="0,22,0,8" />
            <Border Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Choose…" Click="Choose_Click" VerticalAlignment="Center" />
                    <ui:SymbolIcon Symbol="Folder24" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DestinationName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Destination}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding SpaceText}" Margin="0,8,0,0" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FF34C759" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEnoughSpace}" Value="False">
                                <Setter Property="Foreground" Value="#FFFF453A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Files are sorted into Photos, Screenshots and Videos folders." Style="{StaticResource Caption}" Margin="0,4,0,0" />

            <ui:InfoBar Margin="0,16,0,0" IsOpen="{Binding IsMove}" IsClosable="False" Severity="Warning"
                        Title="This deletes from your iPhone"
                        Message="Each file is copied and its size checked against the original. Only files that check out are deleted from the iPhone, and they may not go to Recently Deleted." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Cancel" Click="Cancel_Click" IsCancel="True" MinWidth="90" />
                <ui:Button Content="{Binding StartButtonText}" Click="Start_Click" Appearance="Primary"
                           IsDefault="True" Margin="8,0,0,0" MinWidth="90" IsEnabled="{Binding CanStart}" />
            </StackPanel>
        </StackPanel>

        <!-- ============ Running ============ -->
        <StackPanel Margin="24,4,24,24" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" />
                <TextBlock Text="{Binding RunningTitle}" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" />
            </StackPanel>
            <ProgressBar Margin="0,18,0,0" Height="6" Maximum="100" Value="{Binding Percent}"
                         IsIndeterminate="{Binding IsDeleting}" />
            <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}" FontSize="13" />
                <TextBlock Text="{Binding CurrentName}" Style="{StaticResource Caption}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            <DockPanel Margin="0,20,0,0">
                <ui:Button DockPanel.Dock="Right" Content="Stop" Click="Stop_Click" MinWidth="90" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding FooterText}" />
            </DockPanel>
        </StackPanel>

        <!-- ============ Finished ============ -->
        <StackPanel Margin="24,4,24,24" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
            <ui:SymbolIcon x:Name="ResultIcon" Symbol="CheckmarkCircle48" Filled="True" FontSize="56"
                           HorizontalAlignment="Center" Foreground="#FF34C759" />
            <TextBlock Text="{Binding ResultTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
            <TextBlock Text="{Binding ResultDetail}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Expander Header="{Binding FailuresHeader}" Margin="0,16,0,0"
                      Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
            <DockPanel Margin="0,22,0,0">
                <ui:Button DockPanel.Dock="Right" Content="Done" Appearance="Primary" Click="Cancel_Click"
                           IsDefault="True" MinWidth="90" />
                <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenFolder_Click"
                           HorizontalAlignment="Left" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
